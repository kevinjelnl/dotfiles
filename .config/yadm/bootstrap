#!/usr/bin/bash

SYSTEM_INSTALLER="$HOME/.config/yadm/install-system-packages"
OS_NAME=$(uname -s)
OS_ID="unknown"
OS_LIKE=""
if [[ -r /etc/os-release ]]; then
    . /etc/os-release
    OS_ID=${ID:-unknown}
    OS_LIKE=${ID_LIKE:-}
fi
if [[ "$OS_ID" == unknown && "$OS_NAME" == Darwin ]]; then
    OS_ID=darwin
fi

is_debian_family() {
    [[ "$OS_NAME" == Linux && ( "$OS_ID" == ubuntu || "$OS_ID" == debian || " $OS_LIKE " == *" debian "* ) ]]
}

run_platform_bootstrap() {
    local platform_bootstrap="$HOME/.config/yadm/bootstrap.d/$OS_ID"
    if [[ -x "$platform_bootstrap" ]]; then
        echo "...running platform bootstrap for $OS_ID"
        "$platform_bootstrap" || echo "...platform bootstrap failed for $OS_ID."
    fi
}

prompt_user() {
    while true; do
        read -p "Do you want to install $1? [y/n] " yn
    # read the response
    case $yn in
        [Yy]* ) result=0; break;;
        [Nn]* ) result=1; break;;
        * ) echo "Please answer yes or no.";;
    esac
done
return $result
}

install_system_packages() {
    if [[ "${YADM_INSTALL_SYSTEM_PACKAGES:-0}" != 1 ]]; then
        echo "...skipping system packages: set YADM_INSTALL_SYSTEM_PACKAGES=1 to enable"
        return 0
    fi
    if ! is_debian_family; then
        echo "...skipping system packages: no installer is configured for $OS_NAME/$OS_ID."
        echo "Add an OS-specific installer before enabling system packages on this host."
        return 0
    fi

    if [[ $EUID -eq 0 ]] || sudo -n true 2>/dev/null; then
        SYSTEM_INSTALL_ACCESS=1
    else
        SYSTEM_INSTALL_ACCESS=0
    fi

    prompt_user "system packages"
    if [[ $? == 1 ]]; then return 1; fi

    if [[ $SYSTEM_INSTALL_ACCESS != 1 ]]; then
        echo "...cannot install system packages: this account has no sudo access."
        echo "Ask an administrator to run:"
        echo "  $SYSTEM_INSTALLER"
        echo "Then run 'yadm bootstrap' again as $USER."
        return 1
    fi

    echo "...installing system packages"
    if [[ $EUID -eq 0 ]]; then
        "$SYSTEM_INSTALLER" || return 1
    else
        sudo -n "$SYSTEM_INSTALLER" || return 1
    fi
}

install_tmux_plugins() {
    tmux_dir="$HOME/.tmux/plugins/tpm"
    if [[ ! -d "$tmux_dir" ]] && command -v git >/dev/null 2>&1; then
        git clone https://github.com/tmux-plugins/tpm "$tmux_dir" > /dev/null || true
    fi
}

install_ohmyzsh() {
    if [[ -d "$HOME/.oh-my-zsh" ]]; then
        echo "...Oh My Zsh is already installed."
        return
    fi
    if ! command -v zsh >/dev/null 2>&1; then
        echo "...skipping Oh My Zsh: zsh is not installed."
        echo "Ask an administrator to install zsh, then run 'yadm bootstrap' again."
        return
    fi
    if ! command -v git >/dev/null 2>&1; then
        echo "...skipping Oh My Zsh: git is not installed."
        return
    fi
    prompt_user "Oh My Zsh (user-local)"
    if [[ $? == 1 ]]; then return; fi
    git clone --depth 1 https://github.com/ohmyzsh/ohmyzsh.git "$HOME/.oh-my-zsh" > /dev/null || echo "...Oh My Zsh installation failed."
}

install_nvim() {
    if ! command -v nvim >/dev/null 2>&1; then
        echo "...skipping nvim plugins: neovim is not installed."
        return
    fi
    if ! command -v curl >/dev/null 2>&1; then
        echo "...skipping nvim plugins: curl is not installed."
        return
    fi
    prompt_user "nvim plugins"
    if [[ $? == 1 ]]; then return; fi
    # install vimplug
    local plug_url="https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim"
    curl -s -fLo "${XDG_DATA_HOME:-$HOME/.local/share}/nvim/site/autoload/plug.vim" --create-dirs "$plug_url" || {
        echo "...vim-plug installation failed."
        return
    }
    curl -s -fLo "$HOME/.vim/autoload/plug.vim" --create-dirs "$plug_url" || {
        echo "...vim-plug installation failed for Vim."
        return
    }
    # install the plugins
    nvim --headless '+PlugInstall --sync' +qa || echo "...nvim plugin installation failed."
}

configure_bash_aliases() {
    local bash_aliases="$HOME/.bash_aliases"
    local marker="# yadm: load shared shell aliases"

    if [[ -f "$bash_aliases" ]] && grep -Fqx "$marker" "$bash_aliases"; then
        return
    fi

    if [[ -e "$bash_aliases" ]]; then
        printf '\n%s\nif [[ -r "$HOME/.config/zsh/aliases.zsh" ]]; then\n    . "$HOME/.config/zsh/aliases.zsh"\nfi\n' \
            "$marker" >> "$bash_aliases"
    else
        printf '%s\nif [[ -r "$HOME/.config/zsh/aliases.zsh" ]]; then\n    . "$HOME/.config/zsh/aliases.zsh"\nfi\n' \
            "$marker" > "$bash_aliases"
    fi
}

check_shell_workflow() {
    local configured=1

    if [[ ! -f "$HOME/.tmux.conf" ]] || ! grep -Fxq 'set -g default-shell /bin/zsh' "$HOME/.tmux.conf"; then
        configured=0
    fi
    if [[ -f "$HOME/.bash_profile" ]] && grep -Eq '(^|[[:space:];])((exec[[:space:]]+)?tmux[[:space:]]+(new-session|attach)|tmux[[:space:]]+a([[:space:];]|$))' "$HOME/.bash_profile"; then
        configured=0
    fi
    if [[ ! -f "$HOME/.zshrc" ]] || grep -Fq 'tmux new-session -A -s main' "$HOME/.zshrc"; then
        configured=0
    fi

    if [[ $configured == 1 ]]; then
        echo "...shell workflow configuration is already in place."
    else
        echo "...shell workflow configuration is incomplete; run 'yadm checkout' to restore managed files."
    fi
}

create_symlinks() {
    # symlink the theme for oh-my-zsh when oh-my-zsh is installed
    if [[ -d "$HOME/.oh-my-zsh/themes" && -f "$HOME/.config/zsh/kevinjel.zsh-theme" ]]; then
        ln -sf "$HOME/.config/zsh/kevinjel.zsh-theme" "$HOME/.oh-my-zsh/themes/kevinjel.zsh-theme"
    fi
    # symlink git and vim configs when their sources exist
    [[ -f "$HOME/.config/git/gitconfig" ]] && ln -sf "$HOME/.config/git/gitconfig" "$HOME/.gitconfig"
    [[ -f "$HOME/.config/nvim/init.vim" ]] && ln -sf "$HOME/.config/nvim/init.vim" "$HOME/.vimrc"
}


run_platform_bootstrap
install_system_packages
install_tmux_plugins
install_ohmyzsh
install_nvim
configure_bash_aliases
create_symlinks
check_shell_workflow
echo "...done bootstrapping"
