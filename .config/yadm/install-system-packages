#!/usr/bin/env bash
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    echo "Run this script as root:"
    echo "  sudo $0"
    exit 1
fi

if [[ "$(uname -s)" != Linux ]] || ! command -v apt-get >/dev/null 2>&1; then
    echo "This installer supports Debian-family Linux systems with apt-get only."
    exit 1
fi

package_file="$HOME/.config/yadm/packages/apt-common"
if [[ ! -r "$package_file" ]]; then
    echo "Missing package manifest: $package_file" >&2
    exit 1
fi

mapfile -t packages < <(grep -Ev '^[[:space:]]*(#|$)' "$package_file")

apt-get update
apt-get install -y "${packages[@]}"
